# Backend environment variables (12-factor). Copy to a local .env if you like,
# or set them in the environment / your deploy platform's secrets. None are
# required in development; each has a default in the code.

# Path to the SQLite file. In Docker/Fly it points at the persistent volume.
DB_PATH=./app.db

# API key required in the X-API-Key header. In production use a STRONG key,
# never the development default.
API_KEY=zica123

# Allowed CORS origin. In production, the app's exact domain (locks down "*").
# e.g. https://cecilia-zica.github.io
ALLOWED_ORIGIN=*
