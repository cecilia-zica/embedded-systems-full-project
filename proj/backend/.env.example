# Variáveis de ambiente do backend (12-factor). Copie para .env local se quiser,
# ou defina no ambiente / secrets da plataforma de deploy. Nenhuma é obrigatória
# em dev — todas têm default no código.

# Caminho do arquivo SQLite. No Docker/Fly aponta para o volume persistente.
DB_PATH=./app.db

# Chave de API exigida no header X-API-Key. Em produção, use uma chave FORTE
# e nunca o default de desenvolvimento.
API_KEY=zica123

# Origem permitida no CORS. Em produção, o domínio exato do app (trava o "*").
# Ex.: https://cecilia-zica.github.io
ALLOWED_ORIGIN=*
