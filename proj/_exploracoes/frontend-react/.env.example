# Copie esse arquivo pra ".env" (o Vite carrega .env automaticamente e ele
# fica de fora do git — veja o .gitignore) e ajuste pro seu ambiente.
#
# Por que isso existe: antes o IP e a API key estavam escritos direto dentro
# de src/api/apiService.js. Boa prática é o código nunca ter esse tipo de
# valor "chumbado" — ele muda por ambiente (seu Mac hoje, outro depois) e
# nunca deveria ir pro histórico do git. Variáveis de ambiente resolvem isso:
# o mesmo código roda em qualquer máquina, só trocando o .env.

# IP:porta do backend Go (proj/backend). Ache o IP atual com `ifconfig | grep "inet "`
VITE_API_BASE_URL=http://172.20.10.2:8080

# tem que bater com defaultAPIKey em proj/backend/middleware.go
VITE_API_KEY=zica123
